namespace MathQL.GraphsSmallDB

/-- A row of the `graph` table, decoded into semantic Lean values. -/
structure Graph where
  graph6 : String
  numVertices : Nat
  numEdges : Nat
  degreeSequence : List Nat
  minDegree : Nat
  maxDegree : Nat
  isRegular : Bool
  numComponents : Nat
  isConnected : Bool
  diameter : Option Nat
  radius : Option Nat
  girth : Option Nat
  isTree : Bool
  isForest : Bool
  isBipartite : Bool
  isPlanar : Bool
  isEulerian : Bool
  numTriangles : Nat
  cliqueNumber : Nat
  independenceNumber : Nat
  chromaticNumber : Nat
  automorphismCount : Nat

/-- Decode one row, reading columns in the order of `graphColumns`/`select`. -/
def Graph.decode : SQLite.RowReader Graph := do
  let graph6 ← Column.string
  let numVertices ← Column.nat
  let numEdges ← Column.nat
  let degreeSequence ← Column.natList
  let minDegree ← Column.nat
  let maxDegree ← Column.nat
  let isRegular ← Column.bool
  let numComponents ← Column.nat
  let isConnected ← Column.bool
  let diameter ← Column.natOption
  let radius ← Column.natOption
  let girth ← Column.natOption
  let isTree ← Column.bool
  let isForest ← Column.bool
  let isBipartite ← Column.bool
  let isPlanar ← Column.bool
  let isEulerian ← Column.bool
  let numTriangles ← Column.nat
  let cliqueNumber ← Column.nat
  let independenceNumber ← Column.nat
  let chromaticNumber ← Column.nat
  let automorphismCount ← Column.nat
  return { graph6, numVertices, numEdges, degreeSequence, minDegree, maxDegree,
           isRegular, numComponents, isConnected, diameter, radius, girth,
           isTree, isForest, isBipartite, isPlanar, isEulerian, numTriangles,
           cliqueNumber, independenceNumber, chromaticNumber, automorphismCount }

/-- The queryable columns, in `decode`/`select` order: `(column name, query type)`. -/
def graphColumns : List (String × Ty) :=
  [ ("graph6", .string),
    ("num_vertices", .int), ("num_edges", .int),
    ("degree_sequence", .string),
    ("min_degree", .int), ("max_degree", .int),
    ("is_regular", .bool),
    ("num_components", .int),
    ("is_connected", .bool),
    ("diameter", .int), ("radius", .int), ("girth", .int),
    ("is_tree", .bool), ("is_forest", .bool), ("is_bipartite", .bool),
    ("is_planar", .bool), ("is_eulerian", .bool),
    ("num_triangles", .int),
    ("clique_number", .int), ("independence_number", .int),
    ("chromatic_number", .int), ("automorphism_count", .int) ]

/-- The output fields: each column's value as JSON, off a decoded `Graph`. -/
def graphOutput : List (Label × (Graph → Lean.Json)) :=
  [ (.label "graph6", fun g => Lean.toJson g.graph6),
    (.label "num_vertices", fun g => Lean.toJson g.numVertices),
    (.label "num_edges", fun g => Lean.toJson g.numEdges),
    (.label "degree_sequence", fun g => Lean.toJson g.degreeSequence),
    (.label "min_degree", fun g => Lean.toJson g.minDegree),
    (.label "max_degree", fun g => Lean.toJson g.maxDegree),
    (.label "is_regular", fun g => Lean.toJson g.isRegular),
    (.label "num_components", fun g => Lean.toJson g.numComponents),
    (.label "is_connected", fun g => Lean.toJson g.isConnected),
    (.label "diameter", fun g => Lean.toJson g.diameter),
    (.label "radius", fun g => Lean.toJson g.radius),
    (.label "girth", fun g => Lean.toJson g.girth),
    (.label "is_tree", fun g => Lean.toJson g.isTree),
    (.label "is_forest", fun g => Lean.toJson g.isForest),
    (.label "is_bipartite", fun g => Lean.toJson g.isBipartite),
    (.label "is_planar", fun g => Lean.toJson g.isPlanar),
    (.label "is_eulerian", fun g => Lean.toJson g.isEulerian),
    (.label "num_triangles", fun g => Lean.toJson g.numTriangles),
    (.label "clique_number", fun g => Lean.toJson g.cliqueNumber),
    (.label "independence_number", fun g => Lean.toJson g.independenceNumber),
    (.label "chromatic_number", fun g => Lean.toJson g.chromaticNumber),
    (.label "automorphism_count", fun g => Lean.toJson g.automorphismCount) ]

/-- The `Graph` domain over the `graph` table. -/
def graphDomain : Domain where
  table := "graph"
  inputField := graphColumns.map fun (name, ty) =>
    (.label name, { label := .label name, column := name, ty })
  select := graphColumns.map fun (name, _) => name
  Obj := Graph
  decode := Graph.decode
  outputField := graphOutput

/-- The `graphs-small.db` database: one domain, `Graph`. -/
def database : Database where
  const := []
  domain := [(.domain "Graph", graphDomain)]

end MathQL.GraphsSmallDB
